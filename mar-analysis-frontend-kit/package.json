		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"d3-scale": "^4.0.2",
		"graphology": "^0.26.0",
		"graphology-layout": "^0.6.1",
